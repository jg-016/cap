@startuml CDU_022_Remover_Calendario_da_Turma
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
title CDU-022 — Classes de projeto

class Estudante

package "Controle" {
  class remover_calendario <<view>> {
    +post(request, turma_id, calendario_id)
  }
}

package "Domínio" {
  class Usuario {
    -email: str
    -nome_completo: str
  }

  class Turma {
    -nome: str
    -descricao: str
    -codigo: str
  }

  class MembroDeTurma {
    -eh_admin: bool
    -numero_paleta: int
  }

  class Calendario {
    -nome: str
    -descricao: str
    -turma: Turma?
    +save()
  }
}

Estudante ..> remover_calendario : envia dados
remover_calendario ..> Turma : consulta
remover_calendario ..> MembroDeTurma : valida permissão
remover_calendario ..> Calendario : remove associação e salva

Usuario "1" -- "0..*" MembroDeTurma
Turma "1" -- "0..*" MembroDeTurma
Turma "1" -- "0..*" Calendario : possui

@enduml
