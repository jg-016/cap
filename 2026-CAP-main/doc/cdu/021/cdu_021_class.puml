@startuml CDU_021_Adicionar_Calendario_a_Turma
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0

package "Interface" {
  class "turmas/turma.html" as TurmaTemplate <<template>> {
    formulário criar calendário
    formulário associar calendário existente
    lista de calendários da turma
  }
}

package "Aplicação Django" {
  class "apps.turmas.views" as TurmaViews <<view module>> {
    turma(request, id)
    adicionar_calendario_turma(request, turma_id, calendario_id?)
  }

  class "apps.turmas.urls" as TurmaUrls <<URLconf>> {
    turma/<id>
    criar_calendario_turma/<turma_id>
    adicionar_calendario/<turma_id>
    adicionar_calendario/<turma_id>/<calendario_id>
  }
}

package "Modelos" {
  class Usuario <<model>>

  class Turma <<model>> {
    nome: CharField(100)
    descricao: CharField(500)
    codigo: CharField(6)
  }

  class MembroDeTurma <<model>> {
    eh_admin: Boolean
    numero_paleta: PositiveInteger
  }

  class Calendario <<model>> {
    nome: CharField(100)
    descricao: CharField(500)
    turma: ForeignKey(Turma, null)
  }

  class MembroDeCalendario <<model>> {
    eh_admin: Boolean
    numero_paleta: PositiveInteger
  }
}

TurmaTemplate ..> TurmaViews : envia formulários
TurmaViews ..> Turma : busca turma
TurmaViews ..> MembroDeTurma : verifica permissão de admin
TurmaViews ..> Calendario : cria ou associa
TurmaViews ..> MembroDeCalendario : inclui membros da turma
TurmaUrls ..> TurmaViews : roteia requisições

Usuario "1" -- "0..*" MembroDeTurma
Turma "1" -- "0..*" MembroDeTurma
Turma "0..1" -- "0..*" Calendario : turma
Usuario "1" -- "0..*" MembroDeCalendario
Calendario "1" -- "0..*" MembroDeCalendario

note bottom of TurmaViews
  Somente administrador da turma pode criar
  ou associar calendário. Quando associa
  calendário existente, ele não pode estar
  vinculado a outra turma.
end note

note bottom of MembroDeCalendario
  Os membros da turma são adicionados ao
  calendário, caso ainda não sejam membros.
end note
@enduml
