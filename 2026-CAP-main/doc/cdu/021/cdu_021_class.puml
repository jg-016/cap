@startuml CDU_021_Adicionar_Calendario_a_Turma
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
title CDU-021 — Classes de projeto

class Estudante

package "Controle" {
  class adicionar_calendario <<view>> {
    +post(request, turma_id, calendario_id)
  }
}

package "Domínio" {
  class Usuario {
    -email: str
    -nome_completo: str
  }

  class Turma {
    -nome: str
    -descricao: str
    -codigo: str
  }

  class MembroDeTurma {
    -eh_admin: bool
    -numero_paleta: int
  }

  class Calendario {
    -nome: str
    -descricao: str
    -turma: Turma?
    +save()
  }
}

Estudante ..> adicionar_calendario : envia dados
adicionar_calendario ..> Turma : consulta
adicionar_calendario ..> MembroDeTurma : valida permissão
adicionar_calendario ..> Calendario : associa e salva

Usuario "1" -- "0..*" MembroDeTurma
Turma "1" -- "0..*" MembroDeTurma
Turma "1" -- "0..*" Calendario : possui

@enduml
